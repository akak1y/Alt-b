{
    "name": "alt-backend",
    "version": "0.5.0",
    "private": true,
    "description": "Alt communication platform backend (modular Matrix BFF + direct SDK test client)",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "prettier --check . && eslint . && vitest run"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "matrix-js-sdk": "37.13.0",
        "mysql2": "^3.11.0",
        "sequelize": "^6.37.3",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "eslint": "^9.9.0",
        "globals": "^15.9.0",
        "nodemon": "^3.1.4",
        "prettier": "^3.3.3",
        "vitest": "^2.1.8"
    }
}
