PORT=3000
# Используется только необязательным локальным Synapse из docker-compose.yml
MATRIX_SERVER_NAME=localhost

# Управление регистрационными приглашениями (без настроек функция отключена).
# Укажите адрес Synapse, доступный серверу Alt, включая его Admin API.
ALT_INVITES_SYNAPSE_URL=https://synapse.creatusest.ru
# Полные Matrix ID через запятую; пустое значение никому не даёт доступ.
ALT_INVITES_ALLOWED_USERS=
# Только путь к файлу вне репозитория и public/. Сам ключ сюда не записывать.
ALT_INVITES_ADMIN_TOKEN_FILE=/etc/alt/invites-admin-token
